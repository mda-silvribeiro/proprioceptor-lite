// Cloudflare Workers configuration. Free plan compatible: Durable Objects
// here use the SQLite backend (new_sqlite_classes), which is the class of
// DO available on the free tier.
{
  "name": "proprioceptor-lite",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ingest/*", "/status/*", "/mcp/*", "/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "MOTION_SESSION", "class_name": "MotionSession" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby", "MotionSession"] }],
  "observability": { "enabled": false }
}
