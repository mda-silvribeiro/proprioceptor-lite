    "deploy": "npx wrangler@4 deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@playwright/test": "^1.54.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
