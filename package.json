{
  "name": "proprioceptor-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Give Claude a sense of your motion — from your phone's browser. No app, no account, no location, nothing stored.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -b",
